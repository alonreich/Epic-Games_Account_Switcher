<Window x:Class="Epic_Games_Account_Switcher_Client.SkinPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Epic_Games_Account_Switcher_Client"
        Title="{local:T 'Choose Avatar'}" MinHeight="450" MinWidth="600"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource MainBackground}" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SkinTileButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder" Margin="10" Padding="{TemplateBinding Padding}" CornerRadius="8" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="{DynamicResource IconFill}"/>
                                <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource CardBackground}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="{DynamicResource BtnBorderHover}"/>
                                <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource CardHoverBackground}"/>
                                <Setter TargetName="IconBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="IconBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                <Setter TargetName="IconBorder" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource IconFill}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource MainBackground}" MouseLeftButtonDown="Dialog_DragMove">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{local:T 'CHOOSE AN AVATAR'}" Foreground="{DynamicResource PrimaryTextForeground}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{local:T 'Click an avatar to select it, or double-click to use it right away. Use UPLOAD PHOTO to add your own picture.'}" Foreground="{DynamicResource SubTextForeground}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Fixed width so the avatars wrap into rows (4 per row) and scroll, instead of one row wider than the screen. -->
            <ListBox x:Name="SkinsList" Grid.Row="1" Width="640" MaxHeight="560" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="SkinsList_MouseDoubleClick" SelectionChanged="SkinsList_SelectionChanged" AutomationProperties.Name="{local:T 'Avatars'}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SkinTileButtonStyle}" Click="SkinTile_Click" MouseDoubleClick="SkinTile_MouseDoubleClick" ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding AccessibleName}"
                                ContextMenuOpening="SkinTile_ContextMenuOpening">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{local:T 'Remove this photo'}" Click="RemovePhoto_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid Width="120" Height="120">
                                <Ellipse Width="110" Height="110">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Marks photos the user uploaded (they can be removed; shipped avatars cannot). -->
                                <Border Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                                        Width="26" Height="26" CornerRadius="13" Background="{DynamicResource IconFill}" BorderBrush="{DynamicResource MainBackground}" BorderThickness="2">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource OnAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="{local:T 'UPLOAD PHOTO…'}" Click="Upload_Click" MinWidth="140" Height="35" Margin="0,0,20,0" Style="{StaticResource SecondaryButton}" Padding="16,8"
                        ToolTip="{local:T 'Add your own picture. You can move and zoom it to fit the circle before it is saved.'}" AutomationProperties.Name="{local:T 'Upload your own photo'}"/>
                <Button Content="{local:T 'CANCEL'}" Click="Cancel_Click" Width="100" Height="35" Margin="0,0,20,0" Style="{StaticResource CancelButton}" Padding="10,8" IsCancel="True" ToolTip="{local:T 'Keep the current avatar (Esc)'}"/>
                <Button x:Name="SelectButton" Content="{local:T 'USE AVATAR'}" Click="Select_Click" MinWidth="150" Height="35" Padding="20,8" Style="{StaticResource OkButton}" IsDefault="True" IsEnabled="False" ToolTip="{local:T 'Use the selected avatar (Enter)'}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
