<Window x:Class="Epic_Games_Account_Switcher_Client.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epic Games Account Switcher - Setup" MinWidth="650"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource IconFill}" BorderThickness="2" MouseLeftButtonDown="Window_DragMove">
        <Grid Margin="25" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleLabel" Text="SETUP" Foreground="{DynamicResource IconFill}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Starting…" Foreground="{DynamicResource PrimaryTextForeground}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="PercentageLabel" Text="0%" Foreground="{DynamicResource PrimaryTextForeground}" HorizontalAlignment="Right" FontWeight="Bold"/>
                </Grid>
                <ProgressBar x:Name="MainProgressBar" Height="15" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource HeaderbarBackground}" Foreground="{DynamicResource IconFill}" BorderThickness="0" AutomationProperties.Name="Setup progress"/>
            </StackPanel>
            <Button x:Name="DetailsToggle" Grid.Row="3" Content="SHOW DETAILS" Click="DetailsToggle_Click" Style="{StaticResource SecondaryButton}" Padding="14,6" FontSize="11" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            <ListBox x:Name="LogList" Grid.Row="4" Height="240" Margin="0,10,0,0" Visibility="Collapsed" Background="{DynamicResource HeaderbarBackground}" BorderThickness="0" Foreground="{DynamicResource AccentTextForeground}" FontFamily="Consolas" FontSize="12" Padding="10"
                     AutomationProperties.Name="Setup details">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</Window>
