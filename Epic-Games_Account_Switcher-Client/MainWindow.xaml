<Window x:Class="Epic_Games_Account_Switcher_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Epic_Games_Account_Switcher_Client"
        mc:Ignorable="d"
        Title="Epic Games Account Switcher" Height="650" Width="1000"
        Background="#1F2335" WindowStyle="None" AllowsTransparency="True"
        Icon="..\Application_Icons\Epic-Games_Account_Switcher.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="AccountCardStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Margin="10" Width="180">
                            <Button Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardOuter" Background="Transparent" Padding="0,0,5,5" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Border x:Name="ShadowBorder" Background="Black" CornerRadius="10" Opacity="0.3" Margin="5,5,0,0"/>
                                                <Border x:Name="CardBorder" Background="#292E42" CornerRadius="10" Padding="15" BorderThickness="1" BorderBrush="#414868">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="{Binding LastPlayed, StringFormat='Last played on {0:dd/MM/yyyy}'}" Foreground="#737AA2" FontSize="9" HorizontalAlignment="Center" Margin="0,-8,0,6" Opacity="0.8"/>
                                                        <Border x:Name="ActiveIndicator" Height="4" CornerRadius="2" Margin="0,0,0,12" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#4A4A4A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#BB9AF7"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Ellipse x:Name="ProfilePic" Width="110" Height="110" Margin="0,0,0,12" Stroke="{Binding AccentColor}" StrokeThickness="2" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding ProfileImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock x:Name="ProfileName" Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                                                        <TextBlock x:Name="ProfileEmail" Text="{Binding Email}" Foreground="#7AA2F7" FontSize="10" FontWeight="Normal" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.9"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#CCCC00"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="CardOuter" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="ProfileName" Property="FontSize" Value="18"/>
                                                <Setter TargetName="ProfileEmail" Property="FontSize" Value="11"/>
                                                <Setter TargetName="ProfilePic" Property="Width" Value="120"/>
                                                <Setter TargetName="ProfilePic" Property="Height" Value="120"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#3B4261"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{Binding AccentColor}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBorder" Property="Margin" Value="3,3,0,0"/>
                                                <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu Background="#24283B" Foreground="White" BorderBrush="#414868">
                                        <MenuItem Header="SAVE CURRENT PROFILE" Command="{Binding PlacementTarget.Tag.SaveCurrentProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Foreground="#7AA2F7" ToolTip="Recapture the current logged-in Epic-Games account into this existing profile">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="#7AA2F7" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#414868"/>
                                        <MenuItem Header="EDIT" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" FontWeight="Bold" Foreground="White">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#7AA2F7" FontSize="14" FontWeight="Bold"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#414868"/>
                                        <MenuItem Header="DELETE" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Foreground="#F7768E">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#F7768E" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock x:Name="ProfileDesc" Text="{Binding Description}" Foreground="#66B2FF" FontSize="18" FontFamily="Microsoft Sans Serif" TextWrapping="Wrap" TextAlignment="Center" Margin="10,2,10,0" Height="50" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontSize" Value="20"/>
                                                <Setter Property="Margin" Value="10,40,10,0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#24283B">
            <Grid>
                <TextBlock Text="EPIC GAMES ACCOUNT SWITCHER" VerticalAlignment="Center" Margin="15,0" Foreground="#737AA2" FontSize="12" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="40" Background="Transparent" Foreground="White" BorderThickness="0" Click="Minimize_Click" Cursor="Hand"/>
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Width="40" Background="Transparent" Foreground="#F7768E" BorderThickness="0" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="30,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Select your Account" Foreground="White" FontSize="28" FontWeight="Light"/>
                    <TextBlock Text="Click a card to switch instantly. Right-click to edit." Foreground="#737AA2" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <CheckBox Content="Minimize after switch"
                                  IsChecked="{Binding MinimizeOnSwitchSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="#9AA5CE"
                                  Margin="0,0,16,0"/>
                        <CheckBox Content="Prompt on unsaved login"
                                  IsChecked="{Binding PromptOnUnsavedLoginSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="#9AA5CE"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ CAPTURE CURRENT EPIC GAMES ACCOUNT" Padding="25,10" Background="#4A4A4A" Foreground="White" BorderThickness="0" FontWeight="Bold" Command="{Binding AddAccountCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanToEnabledConverter}}" Cursor="Hand" FontSize="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="AccountsList"
                 Grid.Row="2"
                 ItemsSource="{Binding Accounts}"
                 ItemContainerStyle="{StaticResource AccountCardStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="12,0,12,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="AccountsList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="AccountsList_PreviewMouseMove"
                 DragOver="AccountsList_DragOver"
                 Drop="AccountsList_Drop">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:AnimatedWrapPanel Margin="20,0" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20">
            <Button Content="RESTORE" Command="{Binding RestoreCommand}" Width="100" Height="32" Margin="0,0,10,0" Background="Transparent" Foreground="#737AA2" BorderBrush="#414868" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="Bold"/>
            <Button Content="BACKUP" Command="{Binding BackupCommand}" Width="100" Height="32" Background="#363952" Foreground="White" BorderBrush="#414868" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="Bold"/>
        </StackPanel>

        <ResizeGrip Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" WindowChrome.ResizeGripDirection="BottomRight" Opacity="0.3" Margin="0,0,2,2"/>

        <Grid Grid.RowSpan="3" Background="#AA16161E" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="2" Background="Transparent" Foreground="#7AA2F7" BorderThickness="0"/>
                <TextBlock Text="Loading accounts..." Foreground="#737AA2" Margin="0,10" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Grid>

        <Grid Grid.RowSpan="3" Background="#AA16161E" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Background="Transparent" Foreground="#7AA2F7" BorderThickness="0"/>
                <TextBlock Text="{Binding BusyStatus}" Foreground="White" Margin="0,15" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" Background="#24283B" BorderBrush="#7AA2F7" BorderThickness="2" CornerRadius="12" Padding="34,22" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="1300">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Opacity="0.45" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#7AA2F7" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="28"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="26" VerticalAlignment="Center" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
