<Window x:Class="Epic_Games_Account_Switcher_Client.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Password"
        MinWidth="480"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource MainBackground}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{DynamicResource IconFill}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource MainBackground}" MouseLeftButtonDown="Dialog_DragMove">
        <Grid Margin="26" MaxWidth="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="BACKUP PASSWORD" Foreground="{DynamicResource PrimaryTextForeground}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource SubTextForeground}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="PasswordLabel" Text="Password" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,14" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" AutomationProperties.IsRequiredForForm="True"/>
            </StackPanel>

            <StackPanel x:Name="ConfirmPanel" Grid.Row="3">
                <TextBlock x:Name="ConfirmLabel" Text="Confirm password" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ConfirmPasswordInput" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=ConfirmLabel}" AutomationProperties.IsRequiredForForm="True"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="{DynamicResource WarningForeground}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Content="CANCEL" Click="Cancel_Click" Width="110" Height="38" Margin="0,0,18,0" Padding="10,8" Style="{StaticResource CancelButton}" IsCancel="True"/>
                <Button x:Name="OkButton" Content="CONTINUE" Click="Ok_Click" MinWidth="140" Height="38" Padding="20,8" Style="{StaticResource OkButton}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
