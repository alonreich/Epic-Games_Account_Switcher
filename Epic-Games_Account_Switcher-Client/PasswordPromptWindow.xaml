<Window x:Class="Epic_Games_Account_Switcher_Client.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Password"
        MinWidth="480"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource MainBackground}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{DynamicResource IconFill}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource MainBackground}">
        <Grid Margin="26" MaxWidth="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="BACKUP PASSWORD" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource SubTextForeground}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Password" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordInput" Background="{DynamicResource BtnBackgroundActive}" Foreground="White" BorderBrush="{DynamicResource BtnBorder}" Padding="12" Margin="0,0,0,14" VerticalContentAlignment="Center" FontSize="14" CaretBrush="White" AutomationProperties.Name="Backup password"/>
            </StackPanel>

            <StackPanel x:Name="ConfirmPanel" Grid.Row="3">
                <TextBlock Text="Confirm Password" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ConfirmPasswordInput" Background="{DynamicResource BtnBackgroundActive}" Foreground="White" BorderBrush="{DynamicResource BtnBorder}" Padding="12" Margin="0,0,0,6" VerticalContentAlignment="Center" FontSize="14" CaretBrush="White" AutomationProperties.Name="Confirm backup password"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Content="CANCEL" Click="Cancel_Click" Width="110" Height="38" Margin="0,0,18,0" Style="{StaticResource CancelButton}" IsCancel="True" AutomationProperties.Name="Cancel password prompt"/>
                <Button x:Name="OkButton" Content="CONTINUE" Click="Ok_Click" Width="140" Height="38" Style="{StaticResource OkButton}" IsDefault="True" AutomationProperties.Name="Confirm backup password"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
