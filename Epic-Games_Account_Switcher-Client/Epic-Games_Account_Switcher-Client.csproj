<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RootNamespace>Epic_Games_Account_Switcher_Client</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\Application_Icons\Epic-Games_Account_Switcher.ico</ApplicationIcon>
    <Version>2026.04.01.1310</Version>
    <Authors>Epic-Games_Account_Switcher Team</Authors>
    <Product>Epic-Games_Account_Switcher</Product>
    <AssemblyName>Epic-Games_Account_Switcher</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>



  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.5" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260330">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260302">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Epic-Games_Account_Switcher-Globals\Epic-Games_Account_Switcher-Globals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Application_Icons\Epic-Games_Account_Switcher.ico">
      <Link>Application_Icons\Epic-Games_Account_Switcher.ico</Link>
    </Resource>
  </ItemGroup>

  <Target Name="CopySkins" AfterTargets="Build">
    <ItemGroup>
      <SkinsFiles Include="$(SolutionDir)Skin_Icons\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SkinsFiles)" DestinationFolder="$(TargetDir)Skin_Icons\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAnchors" AfterTargets="Build">
    <ItemGroup>
      <AnchorFiles Include="$(SolutionDir)OpenCV_Anchors\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AnchorFiles)" DestinationFolder="$(TargetDir)OpenCV_Anchors\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
