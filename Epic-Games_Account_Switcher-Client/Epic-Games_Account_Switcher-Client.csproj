<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Epic_Games_Account_Switcher_Client</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\Application_Icons\Epic-Games_Account_Switcher.ico</ApplicationIcon>
    <Authors>Epic-Games_Account_Switcher Team</Authors>
    <Product>Epic-Games_Account_Switcher</Product>
    <AssemblyName>Epic-Games_Account_Switcher</AssemblyName>
    <Platforms>x64</Platforms>
    <LangVersion>14</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Self-contained so users need no separate .NET install; ReadyToRun for fast startup. NativeAOT/trimming are not supported by WPF. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Epic-Games_Account_Switcher-Globals\Epic-Games_Account_Switcher-Globals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Application_Icons\Epic-Games_Account_Switcher.ico">
      <Link>Application_Icons\Epic-Games_Account_Switcher.ico</Link>
    </Resource>
  </ItemGroup>

  <Target Name="CopySkins" AfterTargets="Build">
    <ItemGroup>
      <!-- Relative to this project, not $(SolutionDir): that is empty when the project is built on its own (dev.cmd). -->
      <SkinsFiles Include="$(MSBuildThisFileDirectory)..\Skin_Icons\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SkinsFiles)" DestinationFolder="$(TargetDir)Skin_Icons\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
