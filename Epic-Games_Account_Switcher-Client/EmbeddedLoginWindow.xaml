<Window x:Class="Epic_Games_Account_Switcher_Client.EmbeddedLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Add Account - Epic Games Account Switcher" Height="700" Width="550"
        WindowStartupLocation="CenterOwner" Background="#121212" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#1E1E1E" Padding="10">
            <TextBlock Text="Please sign in to your Epic Games account. All CAPTCHAs and 2FA are natively supported."
                       Foreground="#DDDDDD" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </Border>

        <wv2:WebView2 x:Name="LoginWebView" Grid.Row="1" />
        
        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="#E6000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="Extracting session... Please wait." FontSize="18" Foreground="White" Margin="0,0,0,20"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" BorderThickness="0" Background="#333" Foreground="#7AA2F7" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
