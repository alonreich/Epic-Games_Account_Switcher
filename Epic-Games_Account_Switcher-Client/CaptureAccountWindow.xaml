<Window x:Class="Epic_Games_Account_Switcher_Client.CaptureAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Wizard" MinHeight="600" MinWidth="550"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource MainBackground}" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{DynamicResource IconFill}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource MainBackground}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ACCOUNT WIZARD" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,30">
                <Ellipse Width="150" Height="150" Stroke="{DynamicResource IconFill}" StrokeThickness="2" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" MouseLeftButtonDown="SelectImage_Click">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Ellipse.Fill>
                </Ellipse>

                <Button Click="SelectImage_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="35" Height="35" Background="{DynamicResource IconFill}" BorderThickness="0" Cursor="Hand" ToolTip="Change profile custom avatar icon" AutomationProperties.Name="Change profile avatar">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="✎" Foreground="Black" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="2" VerticalAlignment="Top">
                <TextBlock Text="Friendly Name *" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="AccountNameInput"
                         Style="{StaticResource WatermarkTextBoxStyle}"
                         Tag="e.g., Main Account / Alt 1"
                         Text="{Binding AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Margin="0,0,0,18"
                         ToolTip="Required. Unique display name for this account card.">
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <StackPanel>
                                <AdornedElementPlaceholder x:Name="adornedElement"/>
                                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="{DynamicResource WarningForeground}" FontSize="11" Margin="2,4,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>

                <TextBlock Text="{Binding EmailLabel}" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="AccountEmailInput"
                         Style="{StaticResource WatermarkTextBoxStyle}"
                         Tag="e.g., user@domain.com"
                         Text="{Binding AccountEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Margin="0,0,0,18"
                         ToolTip="Required. Connected Epic Games email address.">
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <StackPanel>
                                <AdornedElementPlaceholder x:Name="adornedElement"/>
                                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="{DynamicResource WarningForeground}" FontSize="11" Margin="2,4,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>

                <TextBlock Text="Fallback Password (Optional, DPAPI Encrypted)" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <PasswordBox x:Name="AccountPasswordInput" Background="{DynamicResource BtnBackgroundActive}" Foreground="White" BorderBrush="{DynamicResource BtnBorder}" Padding="12" Margin="0,0,0,18" VerticalContentAlignment="Center" FontSize="14" CaretBrush="White" ToolTip="Optional fallback password encrypted for this Windows user and stored with the profile data; encrypted value is included in backups." AutomationProperties.Name="Fallback password"/>

                <TextBlock Text="Description" Foreground="{DynamicResource SubTextForeground}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="AccountDescriptionInput"
                         Style="{StaticResource WatermarkTextBoxStyle}"
                         Tag="Add optional notes about ranks, games, or login details..."
                         Text="{Binding AccountDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                          ToolTip="Optional notes or character details."/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                <Button Content="CANCEL" Click="Cancel_Click" Width="120" Height="40" Margin="0,0,20,0" Style="{StaticResource CancelButton}" IsCancel="True" ToolTip="Discard changes and close dialog" AutomationProperties.Name="Cancel account changes"/>
                <Button Content="SAVE CHANGES" Click="Capture_Click" Width="180" Height="40" Style="{StaticResource OkButton}" IsDefault="True" ToolTip="Validate entries and save profile" AutomationProperties.Name="Save account changes"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
