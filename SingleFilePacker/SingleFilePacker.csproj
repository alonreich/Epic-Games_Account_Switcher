<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>..\Application_Icons\Epic-Games_Account_Switcher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Epic Games Account Switcher Setup</AssemblyTitle>
    <Description>Epic Games Account Switcher installer</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
    <EmbeddedResource Include="payload.sha256" Condition="Exists('payload.sha256')" />
  </ItemGroup>
  <!-- Build.cmd passes RequirePayload=true for the distribution build so a missing payload fails loudly instead of producing an empty installer. -->
  <Target Name="EnsurePayloadPresent" BeforeTargets="BeforeBuild" Condition="'$(RequirePayload)' == 'true'">
    <Error Condition="!Exists('payload.zip') Or !Exists('payload.sha256')" Text="payload.zip / payload.sha256 missing. Run the packing step (SingleFilePacker --pack) first." />
  </Target>
</Project>
